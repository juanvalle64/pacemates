# Alle Werte sind öffentlich. Das Strava Client Secret gehört NIE hierher.

# Basispfad. npm run dev nutzt sonst /, npm run build nutzt sonst /pacemates/.
# Für pacemates.de: VITE_BASE=/
# VITE_BASE=/pacemates/

# Öffentliche Adresse, für Teilen-Vorschau und kanonische URL.
# VITE_SITE_URL=https://pacemates.de

# Strava über den PaceMates-Token-Proxy (siehe server/strava-token-proxy/README.md).
# Ohne beide Werte bleibt nur der Weg über eine eigene Strava-API-Anwendung.
# VITE_STRAVA_CLIENT_ID=12345
# VITE_STRAVA_TOKEN_URL=https://pacemates-strava.example.workers.dev/token
